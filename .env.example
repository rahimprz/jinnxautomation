# Postgres connection string. Supabase: use the pooled :6543 URI.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Admin inbox password (minimum 12 characters).
ADMIN_PASSWORD=

# Session signing key. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Extra browser origins allowed to POST the contact form, comma separated.
# Vercel's own production and deployment URLs are trusted automatically; add a
# custom domain here.
ALLOWED_ORIGINS=

# Twenty CRM: every new inquiry becomes a Person, an Opportunity and a Note.
# API key: Twenty → Settings → APIs & Webhooks → Create key.
# Cloud: https://api.twenty.com   Self-hosted: your Twenty URL.
TWENTY_API_URL=
TWENTY_API_KEY=
# Optional. Opportunity stage for new inquiries (default NEW).
TWENTY_OPPORTUNITY_STAGE=

# ---------------------------------------------------------------------------
# Card payments (app/pay/[token])
# ---------------------------------------------------------------------------

# Which Stripe account the server charges against. Anything but "live" is test.
# Decided here and never read from the browser, so a page cannot ask to be paid
# with a test card.
STRIPE_MODE=test

STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# The automation service, which holds the invoices. The lookup URL is read with
# the payment token; the paid URL is written to once Stripe confirms a charge.
INVOICE_LOOKUP_URL=
INVOICE_PAID_URL=
INVOICE_WRITE_SECRET=
